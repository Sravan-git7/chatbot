0000000a42189e.html","h":"","id":2452320084.0},{"c":[{"c":[],"t":"Creation of Periodic Replacement Lists","u":"0a91d0533f8e4308e10000000a174cb4.html","h":"","id":2452320095.0},{"c":[],"t":"Work Order or Notification Creation","u":"1190d0533f8e4308e10000000a174cb4.html","h":"","id":2452320096.0},{"c":[],"t":"Work Order Printout","u":"1790d0533f8e4308e10000000a174cb4.html","h":"","id":2452320097.0}],"t":"Periodic Replacement","u":"dd90d0533f8e4308e10000000a174cb4.html","h":"","id":2452320094.0},{"c":[{"c":[],"t":"Certification","u":"1391d0533f8e4308e10000000a174cb4.html","h":"","id":2452320099.0},{"c":[],"t":"Seal Extension","u":"1691d0533f8e4308e10000000a174cb4.html","h":"","id":2452320100.0}],"t":"Certification","u":"e390d0533f8e4308e10000000a174cb4.html","h":"","id":2452320098.0},{"c":[],"t":"Recording Device Inspection Data in Quality Management","u":"4790d0533f8e4308e10000000a174cb4.html","h":"","id":2452320101.0}],"t":"Device Inspection","u":"d690d0533f8e4308e10000000a174cb4.html","id":2452320082.0},{"c":[],"t":"Add Customer-Specific Fields to the Device Master Data","u":"8e11007aed76429c9ad5b4e9e7531d07.html","id":2452320102.0},{"c":[],"t":"Country/Region-Specific Functions","u":"4baf0596e4bd442d8f208e1f110eb0d3.html","id":2452320103.0}],"deleted":0,"transtype":"html5.uacp","filteringTokens":null,"clientFilters":null,"projectPhio":"bsy1757338222937","projectName":"S4H::OP 2025 001 sec"},"currentPage":{"id":2554998389,"t":"Device Management","u":"8990d0533f8e4308e10000000a174cb4.html","loio":"8990d0533f8e4308e10000000a174cb4","deltaMtTranslate":false},"body":"<!DOCTYPE html\n  SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\" dir=\"ltr\"><head><title>Device Management</title><meta charset=\"utf-8\"><link rel=\"stylesheet\" type=\"text/css\" media=\"screen,projection\" href=\"/resource/css/style-v2.css\"><script type=\"text/javascript\" src=\"js/sap-strings.js\"></script></head><body class=\"en-us sap-light centered navigation-default enumeration-disabled\"><div id=\"d4h5-main-container\" class=\"container_12\" role=\"application\"><div id=\"d4h5-section-container\" class=\"grid_12\"><div id=\"d4h5-main-content\" class=\"grid_8 alpha omega\"><section><div class=\"page topic  - topic-topic \" id=\"loio8990d0533f8e4308e10000000a174cb4\"><h1 class=\"title topictitle1\">Device Management</h1><div class=\"body\"><div class=\"section\"><section class=\"section\" type=\"Purpose\"><h2 class=\"section_title\">Purpose</h2> <p class=\"p\">This component manages technical data, installations, meter readings, and the inspection of devices.</p> <p class=\"p\">If you have activated the <span class=\"ph uicontrol\">Advanced Metering Infrastructure</span> business function <span class=\"ph sap-technical-name sap-technical-name\">(ISU_AMI_1)</span> and you are in an advanced metering infrastructure, you can find more information under <a class=\"xref\" href=\"eb75df7f40b741869203c56b5563b415.html\" title=\"\">Advanced Metering Infrastructure</a>.</p></section></div> <div class=\"section\"><section class=\"section\" type=\"Integration\"><h2 class=\"section_title\">Integration</h2> <p class=\"p\">The following table lists the standard application components that must be integrated into device management before you can manage devices. The device, device category, and device number in the <span class=\"ph uicontrol\">Utilities Industry</span> (IS-U) component correspond to equipment, material, and the serial number in the standard system:</p> <div class=\"table-wrapper tablenoborder\"><table summary=\"\" class=\"table\" frame=\"border\" border=\"1\" rules=\"all\"><colgroup><col width=\"33.333333333333336%\"><col width=\"33.333333333333336%\"><col width=\"33.333333333333336%\"></colgroup><thead class=\"thead\" style=\"text-align;\"><tr class=\"row\"><th class=\"entry\" style=\"vertical-align;\" id=\"d799e96\"><p class=\"p\">Name in IS-U</p></th><th class=\"entry\" style=\"vertical-align;\" id=\"d799e100\"><p class=\"p\">From Component</p></th><th class=\"entry\" style=\"vertical-align;\" id=\"d799e104\"><p class=\"p\">Name in Standard System</p></th></tr></thead><tbody class=\"tbody\"><tr class=\"row\"><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e96 \"><p class=\"p\">Device</p></td><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e100 \"><p class=\"p\"><span class=\"ph uicontrol\">Plant Maintenance</span> (PM)</p></td><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e104 \"><p class=\"p\">Equipment</p></td></tr><tr class=\"row\"><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e96 \"><p class=\"p\">Device Category</p></td><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e100 \"><p class=\"p\"><span class=\"ph uicontrol\">Logistics Basic Data</span> (LO-MD)</p></td><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e104 \"><p class=\"p\">Material</p></td></tr><tr class=\"row\"><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e96 \"><p class=\"p\">Device Number</p></td><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e100 \"><p class=\"p\"><span class=\"ph uicontrol\">Logistics Basic Data</span> (LO-MD)</p></td><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e104 \"><p class=\"p\">Serial Number</p></td></tr></tbody></table></div> <p class=\"p\">The device number is created in MM with the <span class=\"ph uicontrol\">Goods Receipt</span> function and transferred to the device. It can also be generated when you create a device in IS-U. The device is identified by a unique material and serial number combination to distinguish it from other pieces of material that may have the same serial number. The equipment number is the same throughout the system.</p> <div class=\"fig fignone\" id=\"id-37975-loio8990d0533f8e4308e10000000a174cb4--fig-101-63-0\"><div class=\"figbody\"><img class=\"inline\" id=\"loio8990d0533f8e4308e10000000a174cb4__image_z1s_nkp_xkb\" src=\"loiobe9d8bfdc6db4851abb6eeedabc224bb_LowRes.png\"></div></div> <p class=\"p\">MM is also used for the following functions in device flow:</p> <div class=\"table-wrapper tablenoborder\"><table summary=\"\" class=\"table\" frame=\"border\" border=\"1\" rules=\"all\"><colgroup><col width=\"50%\"><col width=\"50%\"></colgroup><thead class=\"thead\" style=\"text-align;\"><tr class=\"row\"><th class=\"entry\" style=\"vertical-align;\" id=\"d799e175\"><p class=\"p\">Function</p></th><th class=\"entry\" style=\"vertical-align;\" id=\"d799e179\"><p class=\"p\">Component</p></th></tr></thead><tbody class=\"tbody\"><tr class=\"row\"><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e175 \"><p class=\"p\">Procurement</p></td><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e179 \"><p class=\"p\"><span class=\"ph uicontrol\">Purchase Requisition</span> and <span class=\"ph uicontrol\">Purchase Order</span> from <span class=\"ph uicontrol\">Purchasing</span> (MM-PUR)</p></td></tr><tr class=\"row\"><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e175 \"><p class=\"p\">Delivery</p></td><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e179 \"><p class=\"p\"><span class=\"ph uicontrol\">Goods Receipt</span> from <span class=\"ph uicontrol\">Inventory Management</span> (MM-IM)</p></td></tr><tr class=\"row\"><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e175 \"><p class=\"p\">Outward Movement (such as scrapping or sales)</p></td><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e179 \"><p class=\"p\"><span class=\"ph uicontrol\">Goods Issue</span> and <span class=\"ph uicontrol\">Return Delivery</span>from MM-IM</p></td></tr><tr class=\"row\"><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e175 \"><p class=\"p\">Stock Transfer</p></td><td class=\"entry\" style=\"vertical-align;\" headers=\"d799e179 \"><p class=\"p\"><span class=\"ph uicontrol\">Goods Issue and Return Delivery</span>from MM-IM</p></td></tr></tbody></table></div> <p class=\"p\">Equipment records are created automatically during <span class=\"ph uicontrol\">goods receipt</span>. Therefore, functions from the PM application component are used, including standard ordering functions and creation of maintenance plans or task lists. Billing is then carried out with the <span class=\"ph uicontrol\">Sales and Distribution</span> (SD) component.</p> <p class=\"p\"><span class=\"ph emphasis emphasis\">See Also</span></p> <ul class=\"ul\"><li class=\"li\"><p class=\"p\">PM: <a class=\"xref\" href=\"a4c6b853dcfcb44ce10000000a174cb4.html\" title=\"\">Equipment</a></p></li><li class=\"li\"><p class=\"p\">LO-MD: <a class=\"xref\" href=\"b724ba53422bb54ce10000000a174cb4.html\" title=\"\">Material Master</a></p></li><li class=\"li\"><p class=\"p\">MM-PUR: <a class=\"xref\" href=\"4c7eb65334e6b54ce10000000a174cb4.html\" title=\"\">Purchase Requisitions</a>, <a class=\"xref\" href=\"9d7eb65334e6b54ce10000000a174cb4.html\" title=\"\">Purchase Orders</a></p></li><li class=\"li\"><p class=\"p\">MM-IM: <a class=\"xref\" href=\"9163bd534f22b44ce10000000a174cb4.html\" title=\"\">Planning Goods Receipts</a>, <a class=\"xref\" href=\"a363bd534f22b44ce10000000a174cb4.html\" title=\"\">Goods Receipts for Purchase Orders</a>, <a class=\"xref\" href=\"ee63bd534f22b44ce10000000a174cb4.html\" title=\"\">Goods Receipts for Orders</a>, <a class=\"xref\" href=\"0664bd534f22b44ce10000000a174cb4.html\" title=\"\">Other Goods Receipts</a>, <a class=\"xref\" href=\"6564bd534f22b44ce10000000a174cb4.html\" title=\"\">Goods Issues</a>.</p></li></ul></section></div></div></div></section><div class=\"clear\"></div>\n</div></div></div></body></html>","isMachineTranslated":0,"githubLink":""}}