+﻿import sys

+import os

+

+PROTECTED_MARKERS = (

+    'data/vector_store/chroma.sqlite3',

+    'page_collection/chroma.sqlite3',

+    'chroma_db',

+)

+

+def _protected_audit_hook(event, args):

+    if event in ('open', 'os.stat', 'os.scandir', 'os.listdir', 'sqlite3.connect'):

+        if args and len(args) > 0:

+            path_str = str(args[0]).lower().replace('\\', '/')

+            if any(marker in path_str for marker in PROTECTED_MARKERS):

+                raise PermissionError(f'[AUDIT GUARD] Blocked attempt to access protected path during test execution: {event} -> {path_str}')

+

+sys.addaudithook(_protected_audit_hook)
