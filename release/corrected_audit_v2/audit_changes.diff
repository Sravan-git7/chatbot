+def test_domain_synonyms_normalization_unit():

+    """Verify normalization rules for capitalization, punctuation, idempotency, and ordinary questions."""

+    import rag_completeness as RC

+

+    cases = [

+        # Capitalization and punctuation variations

+        ("What technical objects exist in SAP Utilities?", "What technical master data objects exist in SAP Utilities?"),

+        ("what technical object exists in sap utilities?", "what technical master data objects exists in sap utilities?"),

+        ("WHAT TECHNICAL OBJECTS EXIST IN SAP UTILITIES???", "WHAT technical master data objects EXIST IN SAP UTILITIES???"),

+        # Clearing rules and Contract Accounts variations

+        ("What is the sequence of clearing rules in Contract Accounts Receivable and Payable?",

+         "What is the sequence of clearing rules clearing types in Contract Accounts Receivable and Payable FI-CA?"),

+        ("what is the clearing rule in contract accounts receivable and payable?",

+         "what is the clearing rule clearing types in contract accounts receivable and payable FI-CA?"),

+        # Already normalized / contains domain terms (idempotency, no duplicate synonyms)

+        ("What are the business and technical master data objects in SAP Utilities?",

+         "What are the business and technical master data objects in SAP Utilities?"),

+        ("What are clearing types in FI-CA?", "What are clearing types in FI-CA?"),

+        # Ordinary questions that do not require rewriting

+        ("How does meter reading estimation work?", "How does meter reading estimation work?"),

+        ("What is an installment plan in FI-CA?", "What is an installment plan in FI-CA?"),

+    ]

+

+    for orig, expected in cases:

+        norm = RC.normalize_domain_synonyms(orig)

+        assert norm == expected, f"Failed on orig='{orig}': got '{norm}', expected '{expected}'"

+        # Verify idempotency

+        norm2 = RC.normalize_domain_synonyms(norm)

+        assert norm2 == norm, f"Not idempotent for '{norm}' -> '{norm2}'"

+

+

