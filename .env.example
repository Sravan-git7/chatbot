# ==============================================================================
# SURA — SAP Utilities Documentation Assistant
# Environment Configuration Template (.env.example)
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# Pipeline Generator
# Supported: "extractive" (default deterministic extractive RAG), "ollama" (optional local LLM)
RAG_GENERATOR=extractive

# Security & CORS
# Comma-separated list of allowed origins. In production, restrict to trusted domains only.
RAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000

# Content Security Policy (CSP) Frame Ancestors
# Restricts where the web app can be embedded in an iframe ('none' or 'self' or trusted URI)
RAG_CSP_FRAME_ANCESTORS='none'

# Debug Output
# 1 = debug payloads enabled when requested by client, 0 = debug disabled
RAG_ENABLE_DEBUG=1

# Static Assets Directory
# Path to built frontend bundle for production static hosting
RAG_STATIC_DIR=web/dist

# Logging & Privacy Controls
# SURA_LOG_QUERIES: 0 = hash query with SHA-256 for privacy (default), 1 = log raw query text
SURA_LOG_QUERIES=0

# SURA_LOG_JSON: 1 = emit structured JSON log events to stdout/stderr (default), 0 = standard text
SURA_LOG_JSON=1

# Rate Limiting Controls
# SURA_RATE_LIMIT_PER_MINUTE: maximum requests allowed per client IP per 60-second window (0 to disable)
SURA_RATE_LIMIT_PER_MINUTE=60

# ==============================================================================
# Phase 3 Feature Flags (Answer-Completeness Experiment)
# CRITICAL: Default to 0 (OFF) in production. Keep OFF unless experimental gates pass.
# ==============================================================================
SURA_INTENT_AWARE=0
SURA_SECTION_SELECTION=0
SURA_ADDITIONAL_EVIDENCE=0
